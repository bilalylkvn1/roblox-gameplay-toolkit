  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">GameplayToolkitDemo</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Toolkit = require(ReplicatedStorage:WaitForChild("GameplayToolkit"))
local makePet = require(ReplicatedStorage:WaitForChild("PetFactory"))
local folder = Instance.new("Folder")
folder.Name = "GameplayToolkitDemo"
folder.Parent = workspace
local colors =
	{ Color3.fromRGB(94, 214, 193), Color3.fromRGB(255, 189, 98), Color3.fromRGB(157, 164, 255) }
local kinds = { "Quad", "Hop", "Bird" }
local pets = {}
for i, kind in ipairs(kinds) do
	local pet = makePet(kind, kind, colors[i], Vector3.new((i - 2) * 14, 2, 0))
	Toolkit.PetRig.Build(pet, { Kind = kind })
	pet.Parent = folder
	pets[i] = pet
end
local target = pets[1]
local now = workspace:GetServerTimeNow()
local plan = Toolkit.Roaming.new({
	boundsFrame = CFrame.new(-14, 0, 0),
	boundsSize = Vector3.new(28, 1, 40),
	origin = target.PrimaryPart.Position,
	radius = 10,
	speed = 4,
	startsAt = now,
})
local elapsed = 0
local connection = RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	local clock = workspace:GetServerTimeNow()
	Toolkit.Roaming.Advance(plan, clock, Vector3.new(-14, 2, 8))
	local p, heading = Toolkit.Roaming.Sample(plan, clock)
	target:PivotTo(CFrame.lookAt(p, p + heading))
	target:SetAttribute("PetWanderTarget", p + heading * 4)
	for i = 2, 3 do
		local center = Vector3.new((i - 2) * 14, 2, 0)
		local a = elapsed * 0.35 + i
		local pos = center + Vector3.new(math.cos(a) * 5, 0, math.sin(a) * 5)
		pets[i]:PivotTo(CFrame.lookAt(pos, pos + Vector3.new(-math.sin(a), 0, math.cos(a))))
	end
end)
script.Destroying:Connect(function()
	connection:Disconnect()
	folder:Destroy()
end)
print("Exact currency demo:", Toolkit.Money.Add("9007199254740991", "10"))
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="10">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="11">
      <Properties>
        <string name="Name">GameplayToolkitTests</string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Money.spec</string>
          <string name="Source"><![CDATA[return function(Money, check)
	local function eq(a, b, message)
		check(a == b, message or (tostring(a) .. " ~= " .. tostring(b)))
	end
	eq(Money.Normalize("000123"), "123", "leading zero normalization")
	eq(Money.Normalize("000"), "0")
	for _, value in ipairs({
		"",
		"-1",
		"1.0",
		"1e3",
		" 12",
		string.rep("1", 41),
		false,
		{},
		-1,
		0.5,
		math.huge,
		0 / 0,
		9007199254740992,
	}) do
		eq(Money.Normalize(value), nil, "reject invalid integer")
	end
	eq(Money.Normalize(9007199254740991), "9007199254740991")
	eq(Money.Compare("999", "1000"), -1)
	eq(Money.Compare("001", "1"), 0)
	eq(Money.Compare("1000000000000000000", "999999999999999999"), 1)
	eq(Money.Add("9007199254740991", "10"), "9007199254741001", "beyond float precision")
	eq(Money.Add("999999999999999999", "1"), Money.MAX)
	eq(Money.Add(Money.MAX, "1"), Money.MAX, "saturating cap")
	eq(
		Money.Add(string.rep("9", 40), string.rep("9", 40)),
		Money.MAX,
		"oversized input carry saturates"
	)
	eq(Money.Subtract(Money.MAX, "1"), "999999999999999999", "borrow across 18 zeroes")
	eq(Money.Subtract("0", "1"), nil, "underflow has no negative result")
	eq(Money.Subtract("1000", "1"), "999")
	eq(Money.Clamp(string.rep("9", 40)), Money.MAX)
	eq(Money.Format("1234567"), "1.2M")
	eq(Money.Format("999"), "999")
	for i = 0, 199 do
		local a = (i * 7919) % 1000000
		local b = (i * 1543 + 17) % 1000000
		eq(Money.Add(tostring(a), tostring(b)), tostring(a + b), "small integer reference addition")
		eq(
			Money.Subtract(tostring(a + b), tostring(b)),
			tostring(a),
			"addition / subtraction roundtrip"
		)
	end
	local a = "9007199254740991"
	for _ = 1, 100 do
		a = Money.Add(a, "1")
	end
	eq(a, "9007199254741091", "repeated addition remains exact")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Pets.spec</string>
          <string name="Source"><![CDATA[return function(Toolkit, check)
	local PetRig, Animator = Toolkit.PetRig, Toolkit.PetAnimator
	local testWorld = Instance.new("WorldModel")
	local function modelFor(kind)
		local model = Instance.new("Model")
		model.Parent = testWorld
		model.Name = "Example" .. kind
		model:SetAttribute("PetViewport", true)
		local function part(name, size, position)
			local p = Instance.new("Part")
			p.Name = name
			p.Size = size
			p.CFrame = CFrame.new(position)
			p.Anchored = true
			p.Parent = model
			return p
		end
		local root = part("Root", Vector3.new(0.2, 0.2, 0.2), Vector3.new(0, 3, 0))
		root.Transparency = 1
		part("Body", Vector3.new(2, 1, 2), Vector3.new(0, 3, 0))
		part("Head", Vector3.new(1, 1, 1), Vector3.new(0, 3.7, -1))
		part("Eye", Vector3.new(0.2, 0.2, 0.1), Vector3.new(0.3, 3.9, -1.55))
		for _, x in ipairs({ -0.8, 0.8 }) do
			part("FrontLeg", Vector3.new(0.4, 1, 0.4), Vector3.new(x, 2, -0.6))
			part("BackLeg", Vector3.new(0.4, 1, 0.4), Vector3.new(x, 2, 0.6))
			part("Wing", Vector3.new(1, 0.2, 1), Vector3.new(x * 2, 3.5, 0))
		end
		part("Tail", Vector3.new(0.3, 0.3, 1), Vector3.new(0, 3, 1.4))
		part("Ear", Vector3.new(0.3, 0.5, 0.3), Vector3.new(-0.3, 4.4, -1))
		part("Ear", Vector3.new(0.3, 0.5, 0.3), Vector3.new(0.3, 4.4, -1))
		return model
	end
	local tag = "GameplayToolkitIsolatedTests"
	local animator = Animator.new({ Tag = tag, WorldRoot = testWorld })
	local models = { testWorld }
	local ok, err = xpcall(function()
		for _, kind in ipairs(PetRig.Kinds) do
			local model = modelFor(kind)
			models[#models + 1] = model
			check(PetRig.Build(model, { Kind = kind, Tag = tag }), "build " .. kind)
			check(model.PrimaryPart ~= nil, "assign PrimaryPart from Root")
			check(not PetRig.Build(model, { Kind = kind, Tag = tag }), "idempotent build")
			local rig = animator:Attach(model)
			check(rig ~= nil and #rig.Joints > 0, "attach " .. kind)
			for _, state in ipairs({ "Idle", "Walk", "Fly" }) do
				local allowed = animator:SetState(model, state)
				check(
					allowed == (state ~= "Fly" or model:GetAttribute("PetCanFly") == true),
					"state validation"
				)
				if allowed then
					for frame = 1, 8 do
						animator:Pose(rig, frame * 0.1, 0.1, state)
						for _, joint in ipairs(rig.Joints) do
							local c = { joint.Motor.C0:GetComponents() }
							for _, value in ipairs(c) do
								check(
									value == value and math.abs(value) < math.huge,
									"finite joint transform"
								)
							end
						end
					end
				end
			end
			animator:Detach(model)
			check(animator.Rigs[model] == nil, "detach removes registration")
			for _, joint in ipairs(rig.Joints) do
				check(joint.Motor.C0 == joint.Base, "restore base pose")
				check(joint.Motor.Enabled, "restore enabled joints")
			end
		end
		local model = modelFor("Quad")
		models[#models + 1] = model
		PetRig.Build(model, { Kind = "Quad", Tag = tag })
		local rig = animator:Attach(model)
		check(animator:Attach(model) == nil, "duplicate attach")
		check(not pcall(animator.SetState, animator, model, "Invalid"), "reject unknown state")
		model:SetAttribute("PetAnimationEnabled", false)
		animator:Step(0.1)
		check(rig.Enabled == false, "animation disabled")
		model:SetAttribute("PetAnimationEnabled", true)
		animator:Step(0.1)
		check(rig.Enabled == true, "animation resumed")
		check(not pcall(animator.Step, animator, -1), "reject negative delta")
		check(not pcall(animator.Step, animator, 0 / 0), "reject NaN delta")
		animator:Stop()
		check(next(animator.Rigs) == nil, "stop clears rigs")
		local world = Instance.new("WorldModel")
		models[#models + 1] = world
		local skinModel = modelFor("Quad")
		models[#models + 1] = skinModel
		skinModel:SetAttribute("PetViewport", false)
		skinModel.Parent = world
		PetRig.Build(skinModel, { Kind = "Quad", Tag = tag })
		local skinner = Animator.new({ Tag = tag, WorldRoot = world })
		local skin = skinner:Attach(skinModel)
		check(skin and skin.Skin ~= nil, "client skinning works in isolated WorldModel")
		for _, joint in ipairs(skin.Joints) do
			check(not joint.Motor.Enabled, "skin disables physics joints")
			check(joint.Motor.Part1.Anchored, "skin anchors posed parts")
		end
		skinner:Pose(skin, 1, 0.1, "Walk")
		skinner:Step(0.1)
		skinModel:SetAttribute("PetAnimationEnabled", false)
		skinner:Step(0.1)
		skinner:Stop()
		for _, joint in ipairs(skin.Joints) do
			check(joint.Motor.Enabled, "stop restores joints after skinning")
			check(not joint.Motor.Part1.Anchored, "stop restores original anchoring")
		end
		local invalid = modelFor("Invalid")
		models[#models + 1] = invalid
		check(
			not pcall(PetRig.Build, invalid, { Kind = "NotAKind", Tag = tag }),
			"reject unknown kind"
		)
	end, debug.traceback)
	animator:Stop()
	for _, model in ipairs(models) do
		model:Destroy()
	end
	assert(ok, err)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Roaming.spec</string>
          <string name="Source"><![CDATA[return function(Roaming, check)
	local function options(frame)
		return {
			boundsFrame = frame or CFrame.new(),
			boundsSize = Vector3.new(80, 1, 60),
			origin = Vector3.new(0, 2, 0),
			radius = 18,
			speed = 9,
			startsAt = 10,
			expiresAt = 80,
		}
	end
	local plan = Roaming.new(options())
	check(not Roaming.Advance(plan, 9, Vector3.new(0, 2, 5)), "before start")
	local seed = 17
	local function random()
		seed = (seed * 48271) % 2147483647
		return seed / 2147483647
	end
	check(Roaming.Advance(plan, 10, Vector3.new(0, 2, 5), random), "initialize")
	for i = 0, 500 do
		local t = 10 + i * 0.1
		Roaming.Advance(
			plan,
			t,
			Vector3.new(math.sin(i * 0.1) * 12, 2, math.cos(i * 0.1) * 12),
			random
		)
		local p, h, travel, speed = Roaming.Sample(plan, t)
		check(Roaming.Inside(plan, p, -0.001), "path remains inside rectangle and radius")
		check(math.abs(h.Magnitude - 1) < 0.001, "unit heading")
		check(
			p.Y == 2 and travel >= 0 and speed >= 0 and speed <= plan.speed,
			"height / travel / speed contract"
		)
	end
	local frame = CFrame.new(100, 0, 50) * CFrame.Angles(0, math.rad(37), 0)
	local opt = options(frame)
	opt.origin = frame:PointToWorldSpace(Vector3.new(0, 2, 0))
	local rotated = Roaming.new(opt)
	Roaming.Advance(rotated, 10, opt.origin + Vector3.new(0, 0, 2), random)
	for i = 1, 100 do
		local t = 10 + i * 0.2
		Roaming.Advance(rotated, t, opt.origin + Vector3.new(10, 0, 0), random)
		check(Roaming.Inside(rotated, Roaming.Sample(rotated, t), -0.001), "rotated bounds")
	end
	local copy = Roaming.new(options())
	check(Roaming.Decode(copy, Roaming.Encode(plan)), "JSON roundtrip")
	local a = Roaming.Sample(plan, plan.updatedAt + 0.05)
	local b = Roaming.Sample(copy, plan.updatedAt + 0.05)
	check((a - b).Magnitude < 0.001, "same deterministic prediction after snapshot")
	local original = copy.updatedAt
	for _, state in ipairs({
		{},
		{ t = original, p = { 0, 2, 0 }, d = { 0, 0, 0 }, g = { 1, 0, 0 }, travel = 0 },
		{ t = original, p = { 0, 2, 0 }, d = { 1, 0, 0 }, g = { 0, 0, 0 }, travel = 0 },
		{ t = original, p = { 0 / 0, 2, 0 }, d = { 1, 0, 0 }, g = { 1, 0, 0 }, travel = 0 },
		{ t = original, p = { 10000, 2, 0 }, d = { 1, 0, 0 }, g = { 1, 0, 0 }, travel = 0 },
		{ t = original - 1, p = { 0, 2, 0 }, d = { 1, 0, 0 }, g = { 1, 0, 0 }, travel = 0 },
		{ t = original, p = { 0, 2, 0 }, d = { 1, 0, 0 }, g = { 1, 0, 0 }, travel = -1 },
	}) do
		check(not Roaming.ApplySnapshot(copy, state), "reject bad / stale snapshot")
	end
	check(copy.updatedAt == original, "rejection leaves state intact")
	check(not Roaming.Decode(copy, "broken"), "invalid JSON")
	local pause = Roaming.new({
		boundsFrame = CFrame.new(),
		boundsSize = Vector3.new(80, 1, 80),
		origin = Vector3.new(0, 2, 0),
	})
	Roaming.Advance(pause, 0, Vector3.new(0, 2, 1), random)
	local decisions = 0
	local function countingRandom()
		decisions += 1
		return 0.5
	end
	Roaming.Advance(pause, 100000, Vector3.new(0, 2, 1), countingRandom)
	check(decisions < 500, "catch-up work stays bounded after long pause")
	local ok = pcall(Roaming.new, {
		boundsFrame = CFrame.Angles(0.3, 0, 0),
		boundsSize = Vector3.new(80, 1, 80),
		origin = Vector3.zero,
	})
	check(not ok, "reject tilted bounds")
	ok = pcall(Roaming.new, {
		boundsFrame = CFrame.new(),
		boundsSize = Vector3.new(80, 1, 80),
		origin = Vector3.new(100, 0, 0),
	})
	check(not ok, "reject origin outside usable rectangle")
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Run</string>
          <string name="Source"><![CDATA[-- Run from Studio's Command Bar after installing the demo project.
return function(Toolkit)
	local total, results = 0, {}
	local function run(name, fn)
		local passed = 0
		fn(function(ok, message)
			assert(ok, name .. ": " .. (message or "check failed"))
			passed += 1
			total += 1
		end)
		results[name] = passed
	end
	run("Money", function(check)
		require(script.Parent["Money.spec"])(Toolkit.Money, check)
	end)
	run("Roaming", function(check)
		require(script.Parent["Roaming.spec"])(Toolkit.Roaming, check)
	end)
	run("Pets", function(check)
		require(script.Parent["Pets.spec"])(Toolkit, check)
	end)
	results.total = total
	print("Gameplay Toolkit: " .. total .. " checks passed")
	return results
end
]]></string>
        </Properties>
      </Item>
